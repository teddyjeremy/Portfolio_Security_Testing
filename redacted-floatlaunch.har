            "size": 9219,
            "text": "1:\"$Sreact.fragment\"\n2:\"/_next/static/immutable/chunks/1uf15myet59k5.js\"\n3:\"/_next/static/immutable/chunks/3ahnuz38hrc3s.js\"\n4:\"/_next/static/immutable/chunks/0lsg138-dowuk.js\"\n5:\"/_next/static/immutable/chunks/1zy63rn4v8skj.js\"\n6:I[41981,[\"$2\",\"$3\",\"$4\",\"$5\"],\"Background\"]\n7:I[22369,[\"$2\",\"$3\",\"$4\",\"$5\"],\"Providers\"]\n8:I[11152,[\"$2\",\"$3\",\"$4\",\"$5\"],\"Header\"]\n9:\"$Sreact.suspense\"\na:I[88287,[\"$2\",\"$3\",\"$4\",\"$5\"],\"default\"]\nb:I[74895,[\"$2\",\"$3\",\"$4\",\"$5\"],\"default\"]\nc:\"/_next/static/immutable/chunks/2o8_jcpdf0oi-.js\"\nd:I[4561,[\"$2\",\"$3\",\"$4\",\"$5\",\"$c\"],\"\"]\n15:I[51680,[\"$2\",\"$3\",\"$4\",\"$5\",\"$c\"],\"DocsToc\"]\n22:\"ViewportBoundary\"\n23:I[51858,[\"$2\",\"$3\",\"$4\",\"$5\"],\"$22\"]\n24:\"MetadataBoundary\"\n25:I[51858,[\"$2\",\"$3\",\"$4\",\"$5\"],\"$24\"]\n26:I[49310,[\"$2\",\"$3\",\"$4\",\"$5\"],\"IconMark\"]\n:HL[\"/_next/static/immutable/chunks/32mgl64-f9tu2.css\",\"style\"]\n:HL[\"/float-mark.png\",\"image\"]\nf:X\nf:C\n10:X\n10:300\n10:C\n13:X\n13:C\n21:X\n21:C\n14:[[\"children\",{\"s\":\"__PAGE__\",\"h\":49314,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"wrap page pg-docs\",\"children\":[[\"$\",\"div\",null,{\"className\":\"dc-head\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"ptitle\",\"children\":\"Docs\"}],[\"$\",\"p\",null,{\"children\":[\"How \",\"Float\",\" works, where the fees go, and what to know before you trade.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"dc-grid\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"dc-side\",\"children\":[\"$\",\"$L15\",null,{\"sections\":[[\"how-it-works\",\"How it works\"],[\"fees\",\"Fees\"],[\"builder\",\"Builder launches\"],[\"rewards\",\"Rewards\"],[\"tickers\",\"Tickers\"],[\"risks\",\"Risks\"],[\"contracts\",\"Contracts\"]]}]}],[\"$\",\"div\",null,{\"className\":\"dc-body\",\"children\":[[\"$\",\"section\",null,{\"id\":\"how-it-works\",\"className\":\"g soft dc-sec \",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"01\"}],\"How it works\"]}],[[\"$\",\"p\",null,{\"children\":[\"Every coin on \",\"Float\",\" is paired with a token: a tokenized stock like NVIDIA, Tesla or McDonald's, a pre-IPO name like OpenAI or Anthropic, a privacy coin (ZEC or XMR), or plain SOL or USDC. Coins trade on the Solana terminal or aggregator of your choice, like Axiom, GMGN or Jupiter. Holder rewards are paid in the paired token (wrapped SOL for SOL-paired coins, which your wallet can unwrap).\"]}],[\"$\",\"div\",null,{\"className\":\"dc-facts\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"1,000,000,000\"}],[\"$\",\"span\",null,{\"children\":\"fixed supply\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"~$20K\"}],[\"$\",\"span\",null,{\"children\":\"starting market cap\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"~$150K\"}],[\"$\",\"span\",null,{\"children\":\"graduates to Raydium\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Forever\"}],[\"$\",\"span\",null,{\"children\":\"liquidity locked\"}]]}]]}],\"$L16\",\"$L17\"]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"]}]]}]]}],[\"$L1e\"],\"$L1f\"]}],\"p\":\"$@20\",\"v\":\"$21\",\"s\":\"$10\"}}]]\n11:[[\"children\",{\"s\":\"docs\",\"h\":49250,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$La\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$Lb\",null,{}]}]]}],\"p\":\"$@12\",\"v\":\"$13\",\"s\":\"$10\"},\"c\":\"$Q14\"}]]\n28:X\n28:C\n2b:X\n2b:C\n0:{\"t\":{\"t\":{\"s\":\"\",\"h\":49234,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/immutable/chunks/32mgl64-f9tu2.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/immutable/chunks/1uf15myet59k5.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/immutable/chunks/3ahnuz38hrc3s.js\",\"async\":true}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/immutable/chunks/0lsg138-dowuk.js\",\"async\":true}],[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/immutable/chunks/1zy63rn4v8skj.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"IgKfaq_variable N57ZFq_variable antialiased\",\"children\":[\"$\",\"body\",null,{\"children\":[[\"$\",\"$L6\",null,{}],[\"$\",\"$L7\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"shell\",\"children\":[[\"$\",\"$L8\",null,{}],[\"$\",\"main\",null,{\"className\":\"flex-1\",\"children\":[\"$\",\"$9\",null,{\"children\":[\"$\",\"$La\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$Lb\",null,{}],\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]]}]}]}],[\"$\",\"footer\",null,{\"className\":\"site-foot wrap\",\"children\":[\"$\",\"div\",null,{\"className\":\"row\",\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/\",\"className\":\"brand\",\"aria-label\":\"Float home\",\"children\":[[\"$\",\"img\",null,{\"src\":\"/float-mark.png\",\"alt\":\"\",\"width\":18,\"height\":18}],\"FLOAT\"]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer\",\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/docs\",\"children\":\"Docs\"}],[\"$\",\"$Ld\",null,{\"href\":\"/terms\",\"children\":\"Terms of Use\"}],[\"$\",\"a\",null,{\"href\":\"https://x.com/floatdotxyz\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"X\"}]]}]]}]}]]}]}]]}]}]]}],\"p\":\"$@e\",\"v\":\"$f\",\"s\":\"$10\"},\"c\":\"$Q11\"},\"h\":{\"r\":[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L23\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"$L25\",null,{\"children\":[[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$9\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Docs · Float\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"How Float works: launches, fees, rewards and risks.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/icon.png?icon.0lodg3a58njn-.png\",\"sizes\":\"256x256\",\"type\":\"image/png\"}],[\"$\",\"link\",\"3\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?apple-icon.0npfr4dyuzlhp.png\",\"sizes\":\"180x180\",\"type\":\"image/png\"}],[\"$\",\"$L26\",\"4\",{}]]}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":\"$@27\",\"v\":\"$28\",\"s\":\"$10\"}},\"a\":\"$@29\",\"u\":\"$@2a\",\"r\":\"$2b\"}\n2e:I[51680,[\"$2\",\"$3\",\"$4\",\"$5\",\"$c\"],\"DocsCopy\"]\n36:I[51858,[\"$2\",\"$3\",\"$4\",\"$5\"],\"OutletBoundary\"]\n16:[\"$\",\"p\",null,{\"children\":\"Coins launch on Raydium LaunchLab with a fixed supply of 1,000,000,000, no mint or freeze authority, and a starting market cap of about $20,000. The price follows a bonding curve as people buy. At about 7.5x (roughly $150,000), the coin graduates: its liquidity moves into a Raydium pool and is locked forever with Raydium's Burn & Earn, so it can never be pulled.\"}]\n17:[\"$\",\"p\",null,{\"children\":\"A creator can make a first buy in the launch transaction itself, so nobody can buy before them. On the launch form, that first buy is capped at 2% of the supply. The cap covers that one buy only: it doesn't limit what a creator buys afterwards like anyone else, or from other wallets.\"}]\n18:[\"$\",\"section\",null,{\"id\":\"fees\",\"className\":\"g soft dc-sec \",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"02\"}],\"Fees\"]}],[[\"$\",\"p\",null,{\"children\":[\"Creators pick a trading fee of \",[\"$\",\"b\",null,{\"children\":\"1%, 2% or 2.5%\"}],\" per buy and sell. Raydium keeps part of it (0.25% while a coin is on its curve). The rest is collected by the \",\"Float\",\" program and split the same way for every standard coin, before and after graduation:\"]}],[\"$\",\"div\",null,{\"className\":\"dc-sbar\",\"aria-hidden\":true,\"children\":[[\"$\",\"i\",\"Holders\",{\"style\":{\"flex\":17.5,\"background\":\"#8cc4ff\",\"boxShadow\":\"0 0 14px #8cc4ff66\"}}],[\"$\",\"i\",\"Flagship\",{\"style\":{\"flex\":30,\"background\":\"#3b82ff\",\"boxShadow\":\"0 0 14px #3b82ff66\"}}],[\"$\",\"i\",\"Traders\",{\"style\":{\"flex\":15,\"background\":\"#1d5bff\",\"boxShadow\":\"0 0 14px #1d5bff66\"}}],[\"$\",\"i\",\"$$FLOAT holders\",{\"style\":{\"flex\":15,\"background\":\"#5b9dff\",\"boxShadow\":\"0 0 14px #5b9dff66\"}}],[\"$\",\"i\",\"Treasury\",{\"style\":{\"flex\":22.5,\"background\":\"#28407e\",\"boxShadow\":\"0 0 14px #28407e66\"}}]]}],[\"$\",\"div\",null,{\"className\":\"dc-stbl\",\"children\":[[\"$\",\"div\",\"Holders\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"17.5%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Holders\"}],[\"$\",\"span\",null,{\"children\":\"Paid to the coin's holders in the paired token, pro rata to how much of the coin they hold.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#8cc4ff\",\"boxShadow\":\"0 0 10px #8cc4ff\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"Flagship\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"30%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Flagship\"}],[\"$\",\"span\",null,{\"children\":\"Buys back and burns $FLOAT, the Float flagship token.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#3b82ff\",\"boxShadow\":\"0 0 10px #3b82ff\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"Traders\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"15%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Traders\"}],[\"$\",\"span\",null,{\"children\":\"Converted to USDC and airdropped to traders by score (see Rewards).\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#1d5bff\",\"boxShadow\":\"0 0 10px #1d5bff\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"$$FLOAT holders\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"15%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"$$FLOAT holders\"}],[\"$\",\"span\",null,{\"children\":\"Converted to USDC and airdropped to $FLOAT holders by average balance (see Rewards).\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#5b9dff\",\"boxShadow\":\"0 0 10px #5b9dff\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"Treasury\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"22.5%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Treasury\"}],[\"$\",\"span\",null,{\"children\":\"Funds the platform.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#28407e\",\"boxShadow\":\"0 0 10px #28407e\"},\"aria-hidden\":true}]]}]]}],[\"$\",\"p\",null,{\"children\":\"Standard coins pay no fee to their creator: the creator share is 0% on every standard coin, old and new. Creators who want a share of their coin's fees can use a builder launch (below).\"}],[\"$\",\"p\",null,{\"children\":[\"Fees build up in Raydium's vaults until someone presses \",[\"$\",\"b\",null,{\"children\":\"Cycle fees\"}],\" on a coin's page (anyone can, and our payout bot does it automatically). Cycling claims them and splits them on chain.\"]}]]]}]\n19:[\"$\",\"section\",null,{\"id\":\"builder\",\"className\":\"g soft dc-sec dc-bld\",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"03\"}],\"Builder launches\"]}],[[\"$\",\"p\",null,{\"children\":[\"A builder launch is a launch type for people building a product. It works like a standard launch (same fee choices, same curve and graduation) with a different split: 50% of the fee \",\"Float\",\" collects goes to the builder's fee wallet, 15% to airdrops, 15% buys back and burns $FLOAT and 20% goes to the treasury. There are no holder rewards on builder coins. Builder launches are sent by \",\"Float\",\"'s own server after it checks that they match a launch made on float.jeremyteddy.dev, so no other tool can bundle a builder launch or add its own instructions, tips or fees.\"]}],[\"$\",\"div\",null,{\"className\":\"dc-sbar\",\"aria-hidden\":true,\"children\":[[\"$\",\"i\",\"Builder\",{\"style\":{\"flex\":50,\"background\":\"#ffffff\",\"boxShadow\":\"0 0 14px #ffffff66\"}}],[\"$\",\"i\",\"Airdrops\",{\"style\":{\"flex\":15,\"background\":\"#8b5cf6\",\"boxShadow\":\"0 0 14px #8b5cf666\"}}],[\"$\",\"i\",\"Flagship\",{\"style\":{\"flex\":15,\"background\":\"#a78bfa\",\"boxShadow\":\"0 0 14px #a78bfa66\"}}],[\"$\",\"i\",\"Treasury\",{\"style\":{\"flex\":20,\"background\":\"#3b1f78\",\"boxShadow\":\"0 0 14px #3b1f7866\"}}]]}],[\"$\",\"div\",null,{\"className\":\"dc-stbl\",\"children\":[[\"$\",\"div\",\"Builder\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"50%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Builder\"}],[\"$\",\"span\",null,{\"children\":\"Goes to the builder's fee wallet.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#ffffff\",\"boxShadow\":\"0 0 10px #ffffff\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"Airdrops\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"15%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Airdrops\"}],[\"$\",\"span\",null,{\"children\":\"Goes to airdrops.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#8b5cf6\",\"boxShadow\":\"0 0 10px #8b5cf6\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"Flagship\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"15%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Flagship\"}],[\"$\",\"span\",null,{\"children\":\"Buys back and burns $FLOAT.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#a78bfa\",\"boxShadow\":\"0 0 10px #a78bfa\"},\"aria-hidden\":true}]]}],[\"$\",\"div\",\"Treasury\",{\"className\":\"dc-sr\",\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"20%\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Treasury\"}],[\"$\",\"span\",null,{\"children\":\"Goes to the treasury.\"}]]}],[\"$\",\"i\",null,{\"style\":{\"background\":\"#3b1f78\",\"boxShadow\":\"0 0 10px #3b1f78\"},\"aria-hidden\":true}]]}]]}],[\"$\",\"p\",null,{\"children\":[\"The fee wallet is chosen at launch (the launching wallet, or any other) and can't be changed afterwards. Its share is paid in the paired token whenever fees are cycled. Before graduation, Raydium caps a creator's cut at 0.5% of each trade: on the 1% level the builder gets its full half (0.375% of each trade), on 2% and 2.5% it gets 0.5% of each trade and the rest is split between airdrops, buyback and treasury in the same 15 : 15 : 20 proportion. After graduation the split is 50 / 15 / 15 / 20 on every level. Builder is a launch type, not an endorsement by\",\" \",\"Float\",\".\"]}]]]}]\n1a:[\"$\",\"section\",null,{\"id\":\"rewards\",\"className\":\"g soft dc-sec \",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"04\"}],\"Rewards\"]}],[[\"$\",\"div\",null,{\"className\":\"dc-rw\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Holders\"}],[\"$\",\"p\",null,{\"children\":\"Every few minutes our payout bot sends each coin's holder share to its holders in the paired token, pro rata, wherever they bought. Rewards are paid into the wallet's token account for that token; if it has none, the bot creates one once the wallet is owed at least $2. Smaller amounts roll over to the next round. Rewards are for holding: if you sell before a payout, what you were still owed goes back to the coin's holders. The coin page shows what has been paid and what is waiting. The Profile page can swap the listed tokens in your wallet to SOL, up to 4 per wallet approval, routed through Jupiter. It also unwraps any wrapped SOL in your wallet, and keeps your token accounts open so rewards keep arriving.\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-rw\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Airdrops\"}],[\"$\",\"p\",null,{\"children\":[\"The airdrop share (\",\"30%\",\" of every standard coin's fees) collects in one vault as USDC. Each airdrop splits it in half: one half for traders, one half for $FLOAT holders. A wallet can be paid from both. Payouts go straight to wallets, and every payment is listed on \",[\"$\",\"$Ld\",null,{\"href\":\"/airdrops\",\"children\":\"Airdrops\"}],\" with its transaction.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Traders.\"}],\" Each wallet gets a score: the fees its trades paid (volume times the coin's fee), times consistency, times a $FLOAT boost. Consistency is \",0.5,\" + \",0.5,\" x days traded / days in the round, and a day counts when the wallet's trades pay at least $\",2,\" in fees that day. The boost is \",\"1.1x / 1.25x / 1.5x for $100 / $1K / $10K\",\" of $FLOAT held through at least\",\" \",80,\"% of the round's hourly snapshots. The top \",500,\" traders by score whose share comes to at least $\",25,\" get paid, in proportion to their score, and no wallet gets more than \",\"5%\",\" of the trader pot. No trader gets back more than the fees it paid in the round: in a quiet round with a big pot, what's over stays in the vault for the next one. Trades on any terminal count. Trades on builder coins count at half their fees, since builder coins put 15% of their fees into the airdrop instead of 30%. A coin's own creator's or builder's trades on that coin don't count. Coins on a newly added pair start counting 7 days after the pair is added (trades before then never count).\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"$$FLOAT holders.\"}],\" During the round, $FLOAT balances are recorded in hourly snapshots taken at random times. A wallet's share of the holder pot is its average balance over those snapshots. It needs an average of \",\"$$250\",\" or more to qualify, payouts under $\",5,\" aren't sent, and no wallet gets more than \",\"5%\",\" of the holder pot. One airdrop can pay at most \",\"1,024\",\" wallets (a limit of the program): holders fill the places the traders leave, biggest average first. Pools, exchanges and\",\" \",\"Float\",\"'s own wallets are left out.\"]}],[\"$\",\"p\",null,{\"children\":[\"Bots get nothing from either pool. A wallet counts as a bot if it made more than \",300,\" trades in one hour, or more than\",\" \",100,\" an hour in \",5,\" or more different hours. Wash trading and volume bots don't count either. The list is reviewed before each airdrop is sent, so it goes out shortly after the snapshot time. The \",[\"$\",\"$Ld\",null,{\"href\":\"/analytics\",\"children\":\"Analytics\"}],\" page shows the leaderboard, any wallet's estimate in both pools, and when the next airdrop goes out.\"]}],\"$L2c\"]}],\"$L2d\"]]}]\n1b:[\"$\",\"section\",null,{\"id\":\"tickers\",\"className\":\"g soft dc-sec \",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"05\"}],\"Tickers\"]}],[[\"$\",\"p\",null,{\"children\":\"Tickers are 1 to 10 letters or numbers, in upper or lower case, and each one can be launched once for free. Case doesn't make a new ticker: $Pepe, $pepe and $PEPE are the same one. Launching a coin with a ticker that already exists costs more the newer that ticker is: 5 SOL if it was launched 15 seconds ago or less, 4 SOL up to 1 minute, 3 SOL up to 1 hour, and 2 SOL after that.\"}],[\"$\",\"div\",null,{\"className\":\"dc-facts dc-tk\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"5 SOL\"}],[\"$\",\"span\",null,{\"children\":\"15 seconds old or less\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"4 SOL\"}],[\"$\",\"span\",null,{\"children\":\"up to 1 minute\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"3 SOL\"}],[\"$\",\"span\",null,{\"children\":\"up to 1 hour\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"b\",null,{\"className\":\"num\",\"children\":\"2 SOL\"}],[\"$\",\"span\",null,{\"children\":\"after that\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"The fee goes to the treasury. The launch page shows the price before you launch, and on this site you never pay more than it shows. If that coin graduates within 48 hours of launch, the wallet that launched it gets back the fee it paid, up to 2 SOL, automatically; this applies to coins launched from November 4, 2026 at 10:01 PM CST. There's no refund when the launch bought more than the first-buy cap, or for wallets blocked for abusing launches (such as large bundled buys). The original coin is not affected and keeps trading.\"}]]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"risks\",\"className\":\"g soft dc-sec \",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"06\"}],\"Risks\"]}],[\"$\",\"ul\",null,{\"className\":\"dc-risks\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Coins are highly speculative. Most lose value, and you can lose everything you put in.\"}],[\"$\",\"li\",null,{\"children\":\"Tokenized stocks are issued by third parties (xStocks, Sunrise, PreStocks and others), not by the companies themselves, and those issuers keep powers over their tokens: they can pause transfers, move or burn tokens from any wallet, or add transfer rules later. If an issuer pauses its stock, trading and rewards for coins paired with it stop until it resumes.\"}],[\"$\",\"li\",null,{\"children\":\"Some pre-IPO tokens charge a fee on every transfer, on top of trading fees: 1% for PreStocks and 0.2% for Tessera.\"}],[\"$\",\"li\",null,{\"children\":\"ZEC and XMR on Solana are bridged tokens, not the native coins. Their value depends on the bridge that issues them, and XMR in particular trades in thinner pools, so large trades move its price more.\"}],[\"$\",\"li\",null,{\"children\":\"xSOL, XBTC and XHYPE are Hylo leveraged tokens: they move several times as much as SOL, BTC or HYPE, in both directions, so coins paired with them and holder rewards paid in them can lose value quickly. XBTC and XHYPE have no Raydium pool into SOL or USDC yet, so the buyback and airdrop shares of their fees stay in the vaults until one exists, then are swapped as usual. Nothing is lost, only delayed.\"}],[\"$\",\"li\",null,{\"children\":[\"Float\",\" is not affiliated with, or endorsed by, the companies whose stocks coins are paired with. A coin is not a share and gives no rights in any company.\"]}],[\"$\",\"li\",null,{\"children\":[\"The \",\"Float\",\" program has not had an outside audit yet. Its upgrade authority and settings are held by a 2-of-3 Squads multisig (address under Contracts below): any upgrade or settings change needs two of its three keys.\"]}],[\"$\",\"li\",null,{\"children\":\"When fees are cycled, the program swaps between tokens with a price guard. A trader who moves the price just before can take up to about 2% of that swap. Most routes go through Raydium CLMM pools, checked against the pool's own price history. Tokens whose deep liquidity is in Raydium's older CPMM or AMM v4 pools are swapped there only by the payout bot, which sets the minimum it accepts from market prices, and the program refuses anything less.\"}],[\"$\",\"li\",null,{\"children\":[\"Float\",\"'s fee tiers are public Raydium LaunchLab platforms, so other apps can launch coins on them outside this site. Those coins don't go through the \",\"Float\",\" program and don't get its fee split or rewards. Only coins listed on this site do.\"]}],[\"$\",\"li\",null,{\"children\":\"Prices and stats on this site come from on-chain data and third-party price feeds, and can be delayed or wrong.\"}]]}]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"contracts\",\"className\":\"g soft dc-sec \",\"children\":[[\"$\",\"h2\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"07\"}],\"Contracts\"]}],[\"$\",\"div\",null,{\"className\":\"dc-ctbl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Float program\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/3KguFi7YYzLgttG46fRism16CfcuNCkDh6U7td9JTqxX\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"3KguFi7YYzLgttG46fRism16CfcuNCkDh6U7td9JTqxX\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"3KguFi7YYzLgttG46fRism16CfcuNCkDh6U7td9JTqxX\",\"label\":\"Float program\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Float config\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/AgaKFP4SfEeeM4r4GcSWBwpEAbfHh7wLkJGHqpWrLBQV\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"AgaKFP4SfEeeM4r4GcSWBwpEAbfHh7wLkJGHqpWrLBQV\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"AgaKFP4SfEeeM4r4GcSWBwpEAbfHh7wLkJGHqpWrLBQV\",\"label\":\"Float config\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Upgrade authority & admin (Squads multisig)\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/2gJuHVeXf8x3VGLfWeDNkrGdReZomtNb635jf3ohSCTU\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"2gJuHVeXf8x3VGLfWeDNkrGdReZomtNb635jf3ohSCTU\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"2gJuHVeXf8x3VGLfWeDNkrGdReZomtNb635jf3ohSCTU\",\"label\":\"Upgrade authority & admin (Squads multisig)\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$$FLOAT (flagship)\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/Bv1a7cEj5aRnJQhMw4kRQqAFesMSd5LwcDnUzq52BMmr\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"Bv1a7cEj5aRnJQhMw4kRQqAFesMSd5LwcDnUzq52BMmr\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"Bv1a7cEj5aRnJQhMw4kRQqAFesMSd5LwcDnUzq52BMmr\",\"label\":\"$$FLOAT (flagship)\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Buyback & burn vault\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/8CskoMx4FaXjp7gzxNzaWQXGXGVBWYnNWXGcisXuDYAa\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"8CskoMx4FaXjp7gzxNzaWQXGXGVBWYnNWXGcisXuDYAa\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"8CskoMx4FaXjp7gzxNzaWQXGXGVBWYnNWXGcisXuDYAa\",\"label\":\"Buyback & burn vault\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Airdrop vault\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/JEK3WrPuiePy8vYmzN7Xfk6YoMChbsiqzBs7X43y3snH\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"JEK3WrPuiePy8vYmzN7Xfk6YoMChbsiqzBs7X43y3snH\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"JEK3WrPuiePy8vYmzN7Xfk6YoMChbsiqzBs7X43y3snH\",\"label\":\"Airdrop vault\"}]]}],[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[\"$L2f\",\"$L30\",\"$L31\"]}],\"$L32\",\"$L33\",\"$L34\",\"$L35\"]}]]}]\n1e:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/immutable/chunks/2o8_jcpdf0oi-.js\",\"async\":true}]\n1f:[\"$\",\"$L36\",null,{\"children\":[\"$\",\"$9\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@37\"}]}]\n2a:false\n2c:[\"$\",\"p\",null,{\"children\":[\"The first airdrop, on November 4 at 17:00 UTC, went to the top 100 wallets by volume since launch. The second, on November 11 at 16:45 UTC, went to the top 250 wallets by volume since the first. \",[\"The third is on \",\"Wednesday, November 25 at 18:00 UTC (12:00 PM CST)\",\" and is the first under these rules: it counts trading since November 11 at 16:45 UTC, and $FLOAT holder snapshots since November 14.\"],\" \",\"The vault's address is under Contracts below.\"]}]\n2d:[\"$\",\"div\",null,{\"className\":\"dc-rw\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Flagship\"}],[\"$\",\"p\",null,{\"children\":[\"The flagship share (\",\"30%\",\" of every standard coin's fees) is swapped to SOL and spent buying $FLOAT, the Float flagship token, which is then burned, automatically and on chain. \",\"40%\",\" of it buys steadily: each buy is as big as a\",1,\"% price move allows, and one goes through whenever this share has built up a full buy, so how often depends on trading on Float.\"]}],[\"$\",\"p\",null,{\"children\":[\"The other \",\"60%\",\" goes into a war chest. The war chest buys when $FLOAT trades below its \",7,\"-day average price (\",\"5%+ below: 25% of the chest; 10%+: 50%; 20%+: all of it\",\"). Money that has waited in the chest for more than \",7,\" days is bought anyway. The team can also trigger\",\" \",[\"$\",\"b\",null,{\"children\":\"Deploy now\"}],\" to spend the chest early. It can only make buying happen sooner, and everything bought is burned. The \",[\"$\",\"$Ld\",null,{\"href\":\"/airdrops\",\"children\":\"Airdrops\"}],\" page shows the chest and its latest buys.\"]}],[\"$\",\"p\",null,{\"children\":[\"$$FLOAT is a separate token launched on Raydium LaunchLab; its own trading fees go to the Float dev wallet, not into this split. The buyback vault is a program account no one holds a key to; its address is under Contracts below, so every buy and burn can be checked on Solscan. The\",\" \",[\"$\",\"$Ld\",null,{\"href\":\"/burns\",\"children\":\"Burns\"}],\" page lists every buy with its transaction and the total burned so far.\"]}]]}]\n2f:[\"$\",\"span\",null,{\"children\":\"Holder payout bot\"}]\n30:[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/6LYfrwR67XS8zJPxD2PTEHKocr3d2MBgkZX8umGTfw6E\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"6LYfrwR67XS8zJPxD2PTEHKocr3d2MBgkZX8umGTfw6E\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}]\n31:[\"$\",\"$L2e\",null,{\"value\":\"6LYfrwR67XS8zJPxD2PTEHKocr3d2MBgkZX8umGTfw6E\",\"label\":\"Holder payout bot\"}]\n32:[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Treasury\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/2LMWFmbGBfw78ZEas2NFmAYfo4bhyBqYboYh9nk3mDFQ\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"2LMWFmbGBfw78ZEas2NFmAYfo4bhyBqYboYh9nk3mDFQ\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"2LMWFmbGBfw78ZEas2NFmAYfo4bhyBqYboYh9nk3mDFQ\",\"label\":\"Treasury\"}]]}]\n33:[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Raydium LaunchLab\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/LanMV9sAd7wArD4vJFi2qDdfnVhFxYSUg6eADduJ3uj\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"LanMV9sAd7wArD4vJFi2qDdfnVhFxYSUg6eADduJ3uj\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"LanMV9sAd7wArD4vJFi2qDdfnVhFxYSUg6eADduJ3uj\",\"label\":\"Raydium LaunchLab\"}]]}]\n34:[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Raydium CPMM\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C\",\"label\":\"Raydium CPMM\"}]]}]\n35:[\"$\",\"div\",null,{\"className\":\"dc-cr\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Raydium Burn & Earn\"}],[\"$\",\"a\",null,{\"href\":\"https://solscan.io/account/LockrWmn6K5twhz3y9w1dQERbmgSaRkfnTeTKbpofwE\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"View on Solscan\",\"children\":[[\"$\",\"code\",null,{\"children\":\"LockrWmn6K5twhz3y9w1dQERbmgSaRkfnTeTKbpofwE\"}],[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":12,\"height\":12,\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\"}]}]]}],[\"$\",\"$L2e\",null,{\"value\":\"LockrWmn6K5twhz3y9w1dQERbmgSaRkfnTeTKbpofwE\",\"label\":\"Raydium Burn & Earn\"}]]}]\n37:null\n29:null\n12:\"$undefined\"\ne:\"$undefined\"\n27:\"$undefined\"\n20:\"$undefined\"\n"
